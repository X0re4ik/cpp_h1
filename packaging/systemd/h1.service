[Unit]
Description=h1 - консольный калькулятор (разовый расчёт)
Documentation=https://github.com/X0re4ik/cpp_study
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Параметры подключения к PostgreSQL (DB_PGHOST, DB_PGPORT, DB_PGDATABASE,
# DB_PGUSER, DB_PGPASSWORD) читаются из /etc/h1/h1.env. Файл ставится пакетом
# и является conffile: при обновлении пакета ваши правки сохраняются.
# Префикс "-" означает, что файл может отсутствовать.
EnvironmentFile=-/etc/h1/h1.env
# Вычисляемое выражение в формате JSON; при необходимости отредактируйте.
# Несколько операций за один запуск не поддерживаются: приложение одноразовое.
ExecStart=/usr/bin/h1 --config '{"left": 2, "right": 2, "operation": "+"}'

[Install]
WantedBy=multi-user.target
